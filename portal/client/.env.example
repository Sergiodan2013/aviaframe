# N8N/Search Configuration
# Update VITE_N8N_BASE_URL with your ngrok URL or production API URL
# Search/price still use n8n-compatible endpoints.
VITE_N8N_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# Individual endpoints (optional, if you need to override search/price endpoints)
VITE_N8N_SEARCH_URL=https://your-ngrok-url.ngrok-free.dev/webhook/drct/search
VITE_N8N_PRICE_URL=https://your-ngrok-url.ngrok-free.dev/webhook/drct/price

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend order flow configuration
# Order create / issue / cancel should go through protected backend routes, not public n8n mutating proxy.
VITE_USE_BACKEND_ORDERS=true
VITE_BACKEND_API_BASE_URL=/api/backend
