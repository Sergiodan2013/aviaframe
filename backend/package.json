{
  "name": "@aviaframe/backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "echo \"Building backend...\" && mkdir -p dist && cp -R src/* dist/ || true",
    "check:security-config": "node scripts/check-security-config.js",
    "test": "jest --runInBand",
    "test:security-cutover": "jest --runInBand tests/security/drct-legacy-proxy-telemetry.test.js tests/security/legacy-proxy-consumer-detection.test.js tests/security/n8n-proxy-fallback.test.js tests/security/internal-surfaces.test.js tests/security/portal-order-actions.test.js tests/security/public-airport-search.test.js",
    "test:n8n": "node scripts/test_n8n.js",
    "redeploy:agency-site": "node scripts/redeploy_agency_site.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.20.0",
    "bottleneck": "^2.19.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "opossum": "^5.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qs": "^6.16.0",
    "uuid": "^13.0.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
