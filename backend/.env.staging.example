# AviaFrame Backend - staging environment example

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

APP_NAME=Aviaframe Backend (staging)
APP_VERSION=0.1.0-staging
LOG_LEVEL=info

# Public URL for this staging backend
BACKEND_URL=https://your-staging-backend.up.railway.app
APP_URL=https://staging-admin.aviaframe.com

# Staging frontend origins
CORS_ORIGINS=https://staging.aviaframe.com,https://staging-admin.aviaframe.com,https://your-staging-site.netlify.app

# Staging Supabase project
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
DOCUMENTS_BUCKET=documents-staging

# Widget/auth/internal
WIDGET_TOKEN_SECRET=replace-with-staging-widget-secret
WIDGET_TOKEN_TTL_SEC=1800
INTERNAL_API_TOKEN=replace-with-staging-internal-token
EMAIL_WEBHOOK_SECRET=replace-with-staging-email-webhook-secret

# Internal QA issuance contour (keep disabled on public staging by default)
INTERNAL_QA_ENABLED=false
INTERNAL_QA_AGENCY_ID=
INTERNAL_QA_ALLOWED_HOSTS=staging-admin.aviaframe.com
INTERNAL_QA_MAX_ACTIVE_TICKETS=5
INTERNAL_QA_VOID_WINDOW_HOURS=20

# DRCT/n8n staging
N8N_WEBHOOK_URL=https://your-staging-n8n.example.com/webhook
N8N_TIMEOUT_MS=30000
N8N_RETRY_ATTEMPTS=2
N8N_RETRY_DELAY_MS=1000

# Email - staging should use sandbox inboxes only
EMAIL_FROM=staging@aviaframe.com
SUPPORT_INBOX=staging-support@aviaframe.com
ADMIN_ALERT_EMAIL=staging-alerts@aviaframe.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Moyasar - use test keys in staging
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_TEST_SECRET_KEY=
MOYASAR_TEST_WEBHOOK_SECRET=

# Tamara - sandbox only
TAMARA_ENABLED=true
TAMARA_ENV=sandbox
TAMARA_BASE_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=
TAMARA_MERCHANT_ID=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_PUBLIC_KEY=
TAMARA_SUCCESS_RETURN_URL=https://staging.aviaframe.com/booking.html
TAMARA_CANCEL_RETURN_URL=https://staging.aviaframe.com/booking.html
TAMARA_FAILURE_RETURN_URL=https://staging.aviaframe.com/booking.html
# Route staging UI traffic only to DRCT sandbox.
DRCT_SANDBOX_HOSTS=testenvavia.netlify.app,sandbox.aviaframe.com,localhost,127.0.0.1
