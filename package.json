{
  "name": "aviaframe",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "widget",
    "portal",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "jest --reporters=default && npm --prefix portal/client run test",
    "build": "npm run -w backend build && npm run -w widget build && npm run -w portal build",
    "build:full": "npm run -w backend build && npm run -w widget build && npm run verify:widget-artifacts && npm run -w portal build && npm --prefix portal/client run build",
    "check:drct-cutover": "node scripts/check-drct-mutating-cutover-readiness.js",
    "check:pre-cutover": "npm run check:drct-cutover && npm --prefix backend run test:security-cutover && npm --prefix portal/client run build",
    "inventory:legacy-drct-cleanup": "node scripts/inventory-legacy-drct-cleanup-candidates.js",
    "report:portal-build-artifacts": "node scripts/report-portal-build-artifacts.js",
    "scan:legacy-drct-references": "node scripts/scan-legacy-drct-references.js",
    "check:n8n-legacy-workflows": "node scripts/check-n8n-legacy-workflows-status.js",
    "check:release": "npm test && npm run build:full",
    "start": "node backend/src/index.js",
    "verify:widget-artifacts": "node scripts/verify-widget-artifacts.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion": "2.1.4",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch": "5.1.9",
    "path-to-regexp": "0.1.13",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "ws": "8.21.3"
  }
}
